---
---

<section
  id="home"
  class="relative min-h-screen flex items-center overflow-hidden bg-brand-950"
  aria-label="Hero"
>
  <!-- Background textile pattern -->
  <div class="absolute inset-0 bg-weave opacity-30"></div>

  <!-- Diagonal warm overlay -->
  <div
    class="absolute inset-0"
    style="background: linear-gradient(135deg, rgba(26,18,8,0.96) 0%, rgba(100,52,8,0.82) 50%, rgba(168,106,20,0.6) 100%);"
  ></div>

  <!-- Decorative vertical lines -->
  <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-transparent via-brand-500 to-transparent opacity-40"></div>
  <div class="absolute right-0 top-0 bottom-0 w-1 bg-gradient-to-b from-transparent via-brand-500 to-transparent opacity-40 hidden lg:block"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-20">
    <div class="max-w-3xl">

      <!-- Label -->
      <div class="flex items-center gap-3 mb-6 opacity-0 animate-fade-in" style="animation-delay:0.1s; animation-fill-mode:forwards;">
        <span class="section-label text-brand-400">Bara Bazar · Khyber</span>
        <span class="w-12 h-px bg-brand-500 inline-block"></span>
        <span class="section-label text-brand-400">Est. Premium Textiles</span>
      </div>

      <!-- Headline -->
      <h1
        class="font-display text-cream font-bold leading-[1.1] mb-6 opacity-0 animate-fade-up"
        style="animation-delay:0.25s; animation-fill-mode:forwards; font-size: clamp(2.5rem, 7vw, 5rem);"
      >
        Afridiyan<br/>
        <em class="text-brand-400 not-italic">Imperial</em><br/>
        Textile Mall
      </h1>

      <!-- Subtitle -->
      <p
        class="font-body text-cream/70 text-lg md:text-xl leading-relaxed max-w-xl mb-10 opacity-0 animate-fade-up"
        style="animation-delay:0.4s; animation-fill-mode:forwards;"
      >
        Your trusted destination for premium quality fabrics — gents, ladies, and seasonal collections — at the most honest prices in Khyber.
      </p>

      <!-- Features row -->
      <div
        class="flex flex-wrap gap-x-6 gap-y-2 mb-10 opacity-0 animate-fade-up"
        style="animation-delay:0.55s; animation-fill-mode:forwards;"
      >
        {['High-Quality Cloth', 'Latest Designs', 'Affordable Prices', 'Honest Service'].map((f) => (
          <span class="flex items-center gap-2 text-sm text-cream/70 font-body">
            <span class="text-brand-400 text-base">✔</span> {f}
          </span>
        ))}
      </div>

      <!-- CTA buttons -->
      <div
        class="flex flex-col sm:flex-row gap-4 opacity-0 animate-fade-up"
        style="animation-delay:0.7s; animation-fill-mode:forwards;"
      >
        <a href="#products" class="btn-primary">
          Explore Products
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="tel:+923060548000" class="btn-outline border-cream/40 text-cream hover:bg-cream hover:text-ink">
          📞 Call Now
        </a>
        <a
          href="https://wa.me/923060548000"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline border-green-600/60 text-green-400 hover:bg-green-600 hover:text-white hover:border-green-600"
        >
          💬 WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 animate-bounce">
    <span class="text-cream/50 text-xs font-body tracking-widest uppercase">Scroll</span>
    <svg class="w-4 h-4 text-cream/50" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>
