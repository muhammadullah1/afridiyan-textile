---
---

<section id="contact" class="py-24 bg-cream-deep relative overflow-hidden">
  <div class="absolute inset-0 bg-weave opacity-20"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16 reveal">
      <p class="section-label mb-3">Find Us</p>
      <h2 class="font-display font-bold text-ink text-4xl md:text-5xl mb-4">
        Visit Our <em class="text-brand-600 not-italic">Shop</em>
      </h2>
      <div class="flex items-center justify-center gap-3 mb-5">
        <span class="w-12 h-px bg-brand-300"></span>
        <span class="text-brand-400 text-lg">✦</span>
        <span class="w-12 h-px bg-brand-300"></span>
      </div>
      <p class="font-body text-ink-muted text-lg max-w-xl mx-auto">
        We'd love to meet you in person. Visit our shop in Bara Bazar, Khyber and browse our complete collection.
      </p>
    </div>

    <!-- Contact cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal">

      <!-- Address -->
      <div class="bg-cream border border-brand-100 p-8 hover:border-brand-300 hover:shadow-lg transition-all duration-300">
        <div class="text-3xl mb-4">📍</div>
        <h3 class="font-display font-semibold text-ink text-lg mb-3">Shop Address</h3>
        <div class="w-8 h-px bg-brand-400 mb-4"></div>
        <address class="font-body text-ink-muted text-sm leading-relaxed not-italic">
          Shop No. 1, Rosu Laro Market<br/>
          Near Minar Masjid<br/>
          Bara Bazar, Khyber<br/>
          KPK, Pakistan
        </address>
        <p class="mt-3 text-xs text-ink-muted font-body">
          📌 Google Plus Code:<br/>
          <span class="font-mono text-brand-600">WF85+45H Peshawar</span>
        </p>
      </div>

      <!-- Phone -->
      <div class="bg-cream border border-brand-100 p-8 hover:border-brand-300 hover:shadow-lg transition-all duration-300">
        <div class="text-3xl mb-4">📞</div>
        <h3 class="font-display font-semibold text-ink text-lg mb-3">Call Us</h3>
        <div class="w-8 h-px bg-brand-400 mb-4"></div>
        <div class="space-y-3">
          <a
            href="tel:+923060548000"
            class="flex items-center gap-3 font-body text-ink-muted hover:text-brand-600 transition-colors text-sm group"
          >
            <span class="w-8 h-8 bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 text-xs group-hover:bg-brand-600 group-hover:text-white transition-all duration-200">📱</span>
            +92 306 0548000
          </a>
          <a
            href="tel:+923328897530"
            class="flex items-center gap-3 font-body text-ink-muted hover:text-brand-600 transition-colors text-sm group"
          >
            <span class="w-8 h-8 bg-brand-50 border border-brand-100 flex items-center justify-center text-brand-600 text-xs group-hover:bg-brand-600 group-hover:text-white transition-all duration-200">📱</span>
            +92 332 8897530
          </a>
        </div>
        <p class="mt-4 text-xs text-ink-muted/70 font-body">Available during business hours</p>
      </div>

      <!-- WhatsApp + Social Link -->
      <div class="bg-cream border border-brand-100 p-8 hover:border-brand-300 hover:shadow-lg transition-all duration-300">
        <div class="text-3xl mb-4">💬</div>
        <h3 class="font-display font-semibold text-ink text-lg mb-3">Quick Connect</h3>
        <div class="w-8 h-px bg-brand-400 mb-4"></div>
        <p class="font-body text-ink-muted text-sm mb-5 leading-relaxed">
          WhatsApp available for quick responses, product photos, and order inquiries.
        </p>
        <div class="space-y-3">
          <a
            href="https://wa.me/923060548000"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 bg-green-600 hover:bg-green-700 text-white px-4 py-2.5 text-sm font-body transition-colors duration-200"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            WhatsApp Us
          </a>
          <a
            href="https://www.facebook.com/profile.php?id=61570711791785"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 text-sm font-body transition-colors duration-200"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Follow on Facebook
          </a>
        </div>
      </div>
    </div>

    <!-- Map embed placeholder -->
    <div class="mt-10 reveal delay-300">
      <div class="bg-brand-900 aspect-video md:aspect-[21/6] flex items-center justify-center relative overflow-hidden">
        <div class="absolute inset-0 bg-weave opacity-20"></div>
        <div class="relative z-10 text-center">
          <div class="text-4xl mb-3">🗺️</div>
          <p class="font-display text-cream text-lg font-semibold mb-2">Bara Bazar, Khyber</p>
          <p class="font-body text-cream/60 text-sm mb-4">Google Plus Code: WF85+45H Peshawar</p>
          <a
            href="https://maps.google.com/?q=WF85%2B45H+Peshawar"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-xs"
          >
            Open in Google Maps
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
