---
---

<footer class="bg-brand-950 text-cream/70 font-body">
  <!-- Main footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <!-- Brand -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-brand-600 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/>
            </svg>
          </div>
          <div>
            <div class="font-display font-bold text-cream text-lg leading-none">Afridiyan</div>
            <div class="text-brand-400 text-[10px] tracking-[0.15em] uppercase">Imperial Textile Mall</div>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-cream/60 mt-4 max-w-xs">
          Your trusted destination for premium quality fabrics in Bara Bazar, Khyber. Serving customers with quality and care.
        </p>
        <a
          href="https://www.facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 mt-5 text-brand-400 hover:text-brand-300 transition-colors text-sm"
          aria-label="Facebook page"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Follow on Facebook
        </a>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="font-display text-cream font-semibold text-base mb-5 tracking-wide">Quick Links</h3>
        <ul class="space-y-2.5 text-sm">
          {[
            ['Home', '#home'],
            ['Products', '#products'],
            ['About Us', '#about'],
            ['Contact', '#contact'],
          ].map(([label, href]) => (
            <li>
              <a href={href} class="hover:text-brand-400 transition-colors duration-200 flex items-center gap-2">
                <span class="w-1 h-1 bg-brand-500 rounded-full inline-block"></span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-display text-cream font-semibold text-base mb-5 tracking-wide">Get In Touch</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <span class="text-brand-400 mt-0.5">📍</span>
            <span>Shop No. 1, Rosu Laro Market,<br/>Near Minar Masjid, Bara Bazar,<br/>Khyber, KPK, Pakistan</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-brand-400">📞</span>
            <a href="tel:+923060548000" class="hover:text-brand-400 transition-colors">+92 306 0548000</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-brand-400">📞</span>
            <a href="tel:+923328897530" class="hover:text-brand-400 transition-colors">+92 332 8897530</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-brand-400">💬</span>
            <a
              href="https://wa.me/923060548000"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-brand-400 transition-colors"
            >WhatsApp Available</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-brand-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-cream/40">
      <span>© {new Date().getFullYear()} Afridiyan Imperial Textile Mall (Private) Limited. All rights reserved.</span>
      <span>Bara Bazar, Khyber, KPK, Pakistan</span>
    </div>
  </div>
</footer>
